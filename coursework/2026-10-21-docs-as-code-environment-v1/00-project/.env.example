# Copy to .env at the project root. / Скопируйте в .env в корне проекта.
# Development only; no credentials are needed in this skeleton.
APP_ENV=development
# Unset uses an absolute SQLite path in backend/data, independent of cwd.
# For a custom SQLite location, use sqlite:////absolute/path/to/database.db.
# Create its parent directory first; relative paths depend on the launch directory.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
API_PROXY_TARGET=http://127.0.0.1:8000
# PostgreSQL is an extension point, not a verified migration:
# DATABASE_URL=postgresql+psycopg://studyspace:CHANGE_ME@localhost:5432/studyspace
# Install the backend postgres extra first. Never put secrets in VITE_* variables.
