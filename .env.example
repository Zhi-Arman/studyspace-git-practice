# Native development. Docker Compose supplies its own local configuration.
APP_ENV=development
SEED_DEMO=true
# Unset DATABASE_URL uses backend/data/studyspace.db (absolute path).
# DATABASE_URL=sqlite:////absolute/path/to/studyspace.db
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
API_PROXY_TARGET=http://127.0.0.1:8000
# start_local.sh supplies same-origin settings automatically for its selected port.
# No school verification, server, domain or default administrator password.
